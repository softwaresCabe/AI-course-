# Postgres for progress sync (Railway, Neon, Supabase, RDS…). Run `npm run db:init` once.
DATABASE_URL=postgres://user:password@host:5432/course
# Enables the AI TA and rubric grading of written answers.
ANTHROPIC_API_KEY=
# Optional: model override (defaults to claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Optional but recommended for public deployments: shared secret required by /api/progress and /api/ai.
COURSE_ACCESS_TOKEN=
