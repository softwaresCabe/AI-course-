# ─── Database (required for accounts, purchases, tutor tokens, progress sync, MCP keys) ───
# Neon / Railway / Supabase / RDS. Run `npm run db:migrate` after setting it (safe to re-run).
DATABASE_URL=postgres://user:password@host:5432/course

# ─── Clerk (accounts) — https://dashboard.clerk.com → API keys ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated verified emails and/or Clerk user ids with full, unmetered access (e.g. you, the author).
ADMIN_EMAILS=
ADMIN_USER_IDS=

# ─── Stripe (payments) — https://dashboard.stripe.com/apikeys ───
STRIPE_SECRET_KEY=
# Webhook endpoint: https://<your-domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=
# Public site URL (used for Stripe success/cancel redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Anthropic (AI tutor + rubric grading) ───
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
TUTOR_EFFORT=medium

# ─── Pricing (cents) and token grants — all optional ───
CURRENCY=usd
COURSE_PRICE_CENTS=19900
COURSE_INCLUDED_TOKENS=1000000
FREE_TUTOR_TOKENS=50000
TOKENS_1M_PRICE_CENTS=1000
TOKENS_3M_PRICE_CENTS=2500
TOKENS_10M_PRICE_CENTS=7000

# ─── Limits — optional ───
GRADES_PER_DAY=60
TUTOR_REQUESTS_PER_HOUR=60

# Shown on the pricing page for billing/refund questions.
SUPPORT_EMAIL=

# ─── Open mode ───
# true = no accounts, everything unlocked, AI unmetered. For local study or a PRIVATE personal deployment only:
# never set this on a public URL with an ANTHROPIC_API_KEY. Defaults to on in `npm run dev` when Clerk keys are
# absent, and off in production (a production build without Clerk keys fails closed: only Week 1 is open).
OPEN_ACCESS=
