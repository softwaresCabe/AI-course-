{
  "name": "ai-engineering-course",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/gen-lectures.mjs",
    "dev": "npm run content && next dev",
    "build": "npm run content && next build",
    "start": "next start",
    "db:init": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "dev:artifact": "npm run content && vite",
    "build:artifact": "npm run content && tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.next.json --noEmit",
    "lint": "oxlint src app"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "marked": "^18.2.1",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
