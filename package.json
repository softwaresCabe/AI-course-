{
  "name": "ai-engineering-course",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/gen-lectures.mjs",
    "dev": "npm run content && next dev",
    "build": "npm run content && next build && node scripts/check-bundle.mjs",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "db:init": "node scripts/migrate.mjs",
    "dev:artifact": "npm run content && vite",
    "build:artifact": "npm run content && tsc -b && vite build",
    "typecheck": "npm run content && tsc -b && tsc -p tsconfig.next.json --noEmit",
    "lint": "oxlint src app server",
    "test": "npm run content && vitest run",
    "test:e2e": "playwright test --trace off",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build && npm run build:artifact"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@clerk/nextjs": "^7.10.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "marked": "^18.2.1",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
